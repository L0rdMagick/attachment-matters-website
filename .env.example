# Firebase Public Configuration
PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=family-trust-therapy-portal.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=family-trust-therapy-portal
PUBLIC_FIREBASE_STORAGE_BUCKET=family-trust-therapy-portal.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Emulator Toggle (Set to 'true' for local development)
PUBLIC_USE_EMULATORS=true

# Google Calendar OAuth Config (Server Secrets - Store in Secret Manager for production)
GCAL_CLIENT_ID=your_gcal_oauth_client_id
GCAL_CLIENT_SECRET=your_gcal_oauth_client_secret
GCAL_REDIRECT_URI=https://familytrusttherapy.com/portal/api/gcal/callback
